{
	admin off

	# TLS terminates at the edge, so log the client behind it
	servers {
		trusted_proxies static private_ranges
	}
}

:8000 {
	root * /srv/site
	encode zstd gzip
	file_server
	log

	# mkdocs does not fingerprint asset names, so nothing here can be immutable
	@assets path *.css *.js
	header @assets Cache-Control "public, max-age=3600"

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
